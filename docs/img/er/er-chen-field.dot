graph ER {
  layout=neato;
  overlap=prism; overlap_scaling=-6; sep="+14"; splines=true;
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
  labelloc=t; fontsize=20; fontname="Helvetica-Bold"; label="ER diagram (Chen): Field work and events";
  e_USER_ACCOUNT [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="USER_ACCOUNT"];
  e_MUNICIPALITY [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="MUNICIPALITY"];
  e_PREMISE [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="PREMISE"];
  e_METER [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="METER"];
  e_SERVICE_REQUEST [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="SERVICE_REQUEST"];
  e_TECHNICIAN_CATEGORY [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="TECHNICIAN_CATEGORY"];
  a_TECHNICIAN_CATEGORY_CategoryID [shape=ellipse, style="filled", fillcolor=white, label=<<U>CategoryID</U>>];
  a_TECHNICIAN_CATEGORY_Name [shape=ellipse, style=filled, fillcolor=white, label="Name"];
  e_DOCUMENT [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="DOCUMENT"];
  a_DOCUMENT_DocumentID [shape=ellipse, style="filled", fillcolor=white, label=<<U>DocumentID</U>>];
  a_DOCUMENT_DocType [shape=ellipse, style=filled, fillcolor=white, label="DocType"];
  a_DOCUMENT_DocNumber [shape=ellipse, style=filled, fillcolor=white, label="DocNumber"];
  a_DOCUMENT_IssueDate [shape=ellipse, style=filled, fillcolor=white, label="IssueDate"];
  a_DOCUMENT_ExpiryDate [shape=ellipse, style=filled, fillcolor=white, label="ExpiryDate"];
  e_FIELD_TASK [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="FIELD_TASK"];
  a_FIELD_TASK_TaskID [shape=ellipse, style="filled", fillcolor=white, label=<<U>TaskID</U>>];
  a_FIELD_TASK_TaskType [shape=ellipse, style=filled, fillcolor=white, label="TaskType"];
  a_FIELD_TASK_ScheduledFrom [shape=ellipse, style=filled, fillcolor=white, label="ScheduledFrom"];
  a_FIELD_TASK_ScheduledTo [shape=ellipse, style=filled, fillcolor=white, label="ScheduledTo"];
  a_FIELD_TASK_Status [shape=ellipse, style=filled, fillcolor=white, label="Status"];
  e_ATTACHMENT [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="ATTACHMENT"];
  a_ATTACHMENT_AttachmentID [shape=ellipse, style="filled", fillcolor=white, label=<<U>AttachmentID</U>>];
  a_ATTACHMENT_FilePath [shape=ellipse, style=filled, fillcolor=white, label="FilePath"];
  a_ATTACHMENT_Caption [shape=ellipse, style=filled, fillcolor=white, label="Caption"];
  a_ATTACHMENT_UploadedAt [shape=ellipse, style=filled, fillcolor=white, label="UploadedAt"];
  e_AVAILABILITY [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="AVAILABILITY", peripheries=2];
  a_AVAILABILITY_AvailDate [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>AvailDate</U>>];
  a_AVAILABILITY_FromTime [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>FromTime</U>>];
  a_AVAILABILITY_ToTime [shape=ellipse, style=filled, fillcolor=white, label="ToTime"];
  e_TASK_NOTE [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="TASK_NOTE", peripheries=2];
  a_TASK_NOTE_NoteNo [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>NoteNo</U>>];
  a_TASK_NOTE_NoteKind [shape=ellipse, style=filled, fillcolor=white, label="NoteKind"];
  a_TASK_NOTE_Text [shape=ellipse, style=filled, fillcolor=white, label="Text"];
  a_TASK_NOTE_WrittenAt [shape=ellipse, style=filled, fillcolor=white, label="WrittenAt"];
  e_TELEMETRY_PACKET [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="TELEMETRY_PACKET"];
  e_EVENT [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="EVENT"];
  a_EVENT_EventID [shape=ellipse, style="filled", fillcolor=white, label=<<U>EventID</U>>];
  a_EVENT_EventType [shape=ellipse, style=filled, fillcolor=white, label="EventType"];
  a_EVENT_Severity [shape=ellipse, style=filled, fillcolor=white, label="Severity"];
  a_EVENT_Description [shape=ellipse, style=filled, fillcolor=white, label="Description"];
  a_EVENT_OccurredAt [shape=ellipse, style=filled, fillcolor=white, label="OccurredAt"];
  e_METER_INSTALLATION [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="METER_INSTALLATION"];
  a_METER_INSTALLATION_InstallationID [shape=ellipse, style="filled", fillcolor=white, label=<<U>InstallationID</U>>];
  a_METER_INSTALLATION_InstalledAt [shape=ellipse, style=filled, fillcolor=white, label="InstalledAt"];
  a_METER_INSTALLATION_RemovedAt [shape=ellipse, style=filled, fillcolor=white, label="RemovedAt"];
  a_METER_INSTALLATION_ConfirmationStatus [shape=ellipse, style=filled, fillcolor=white, label="ConfirmationStatus"];
  a_METER_INSTALLATION_ConfirmedAt [shape=ellipse, style=filled, fillcolor=white, label="ConfirmedAt"];
  r_FK_DOCUMENT_TECH_DOC [shape=diamond, style=filled, fillcolor="#fbeeb8", label="TECH DOC", height=0.7, width=1.3];
  r_FK_DOCUMENT_METER_DOC [shape=diamond, style=filled, fillcolor="#fbeeb8", label="METER DOC", height=0.7, width=1.3];
  r_FK_DOCUMENT_REVIEWS [shape=diamond, style=filled, fillcolor="#fbeeb8", label="REVIEWS", height=0.7, width=1.3];
  r_FK_FIELD_TASK_ASSIGNED_TO [shape=diamond, style=filled, fillcolor="#fbeeb8", label="ASSIGNED TO", height=0.7, width=1.3];
  r_FK_FIELD_TASK_TASK_AT [shape=diamond, style=filled, fillcolor="#fbeeb8", label="TASK AT", height=0.7, width=1.3];
  r_FK_FIELD_TASK_TASK_ON [shape=diamond, style=filled, fillcolor="#fbeeb8", label="TASK ON", height=0.7, width=1.3];
  r_FK_FIELD_TASK_RESOLVED_BY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="RESOLVED BY", height=0.7, width=1.3];
  r_FK_ATTACHMENT_EVIDENCE [shape=diamond, style=filled, fillcolor="#fbeeb8", label="EVIDENCE", height=0.7, width=1.3];
  r_FK_AVAILABILITY_DECLARES [shape=diamond, style=filled, fillcolor="#fbeeb8", peripheries=2, label="DECLARES", height=0.7, width=1.3];
  r_FK_TASK_NOTE_HAS_NOTE [shape=diamond, style=filled, fillcolor="#fbeeb8", peripheries=2, label="HAS NOTE", height=0.7, width=1.3];
  r_FK_TASK_NOTE_WROTE [shape=diamond, style=filled, fillcolor="#fbeeb8", label="WROTE", height=0.7, width=1.3];
  r_IN_CATEGORY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="IN CATEGORY", height=0.7, width=1.3];
  r_AVAILABLE_IN [shape=diamond, style=filled, fillcolor="#fbeeb8", label="AVAILABLE IN", height=0.7, width=1.3];
  r_NOTIFIES [shape=diamond, style=filled, fillcolor="#fbeeb8", label="NOTIFIES", height=0.7, width=1.3];
  r_FK_EVENT_EVENT_ON [shape=diamond, style=filled, fillcolor="#fbeeb8", label="EVENT ON", height=0.7, width=1.3];
  r_FK_EVENT_EVENT_FROM [shape=diamond, style=filled, fillcolor="#fbeeb8", label="EVENT FROM", height=0.7, width=1.3];
  r_FK_EVENT_FOUND_DURING [shape=diamond, style=filled, fillcolor="#fbeeb8", label="FOUND DURING", height=0.7, width=1.3];
  r_LEADS_TO [shape=diamond, style=filled, fillcolor="#fbeeb8", label="LEADS TO", height=0.7, width=1.3];
  r_FK_METER_INSTALLATION_INSTALLED [shape=diamond, style=filled, fillcolor="#fbeeb8", label="INSTALLED", height=0.7, width=1.3];
  r_FK_METER_INSTALLATION_INSTALLED_AT [shape=diamond, style=filled, fillcolor="#fbeeb8", label="INSTALLED AT", height=0.7, width=1.3];
  r_FK_METER_INSTALLATION_CONFIRMS [shape=diamond, style=filled, fillcolor="#fbeeb8", label="CONFIRMS", height=0.7, width=1.3];
  r_FK_METER_INSTALLATION_DONE_IN [shape=diamond, style=filled, fillcolor="#fbeeb8", label="DONE IN", height=0.7, width=1.3];
  e_TECHNICIAN_CATEGORY -- a_TECHNICIAN_CATEGORY_CategoryID;
  e_TECHNICIAN_CATEGORY -- a_TECHNICIAN_CATEGORY_Name;
  e_DOCUMENT -- a_DOCUMENT_DocumentID;
  e_DOCUMENT -- a_DOCUMENT_DocType;
  e_DOCUMENT -- a_DOCUMENT_DocNumber;
  e_DOCUMENT -- a_DOCUMENT_IssueDate;
  e_DOCUMENT -- a_DOCUMENT_ExpiryDate;
  e_FIELD_TASK -- a_FIELD_TASK_TaskID;
  e_FIELD_TASK -- a_FIELD_TASK_TaskType;
  e_FIELD_TASK -- a_FIELD_TASK_ScheduledFrom;
  e_FIELD_TASK -- a_FIELD_TASK_ScheduledTo;
  e_FIELD_TASK -- a_FIELD_TASK_Status;
  e_ATTACHMENT -- a_ATTACHMENT_AttachmentID;
  e_ATTACHMENT -- a_ATTACHMENT_FilePath;
  e_ATTACHMENT -- a_ATTACHMENT_Caption;
  e_ATTACHMENT -- a_ATTACHMENT_UploadedAt;
  e_AVAILABILITY -- a_AVAILABILITY_AvailDate;
  e_AVAILABILITY -- a_AVAILABILITY_FromTime;
  e_AVAILABILITY -- a_AVAILABILITY_ToTime;
  e_TASK_NOTE -- a_TASK_NOTE_NoteNo;
  e_TASK_NOTE -- a_TASK_NOTE_NoteKind;
  e_TASK_NOTE -- a_TASK_NOTE_Text;
  e_TASK_NOTE -- a_TASK_NOTE_WrittenAt;
  e_EVENT -- a_EVENT_EventID;
  e_EVENT -- a_EVENT_EventType;
  e_EVENT -- a_EVENT_Severity;
  e_EVENT -- a_EVENT_Description;
  e_EVENT -- a_EVENT_OccurredAt;
  e_METER_INSTALLATION -- a_METER_INSTALLATION_InstallationID;
  e_METER_INSTALLATION -- a_METER_INSTALLATION_InstalledAt;
  e_METER_INSTALLATION -- a_METER_INSTALLATION_RemovedAt;
  e_METER_INSTALLATION -- a_METER_INSTALLATION_ConfirmationStatus;
  e_METER_INSTALLATION -- a_METER_INSTALLATION_ConfirmedAt;
  e_USER_ACCOUNT -- r_FK_DOCUMENT_TECH_DOC [taillabel="1", labeldistance=2];
  e_DOCUMENT -- r_FK_DOCUMENT_TECH_DOC [taillabel="N", labeldistance=2];
  e_METER -- r_FK_DOCUMENT_METER_DOC [taillabel="1", labeldistance=2];
  e_DOCUMENT -- r_FK_DOCUMENT_METER_DOC [taillabel="N", labeldistance=2];
  e_USER_ACCOUNT -- r_FK_DOCUMENT_REVIEWS [taillabel="1", labeldistance=2];
  e_DOCUMENT -- r_FK_DOCUMENT_REVIEWS [taillabel="N", labeldistance=2];
  e_USER_ACCOUNT -- r_FK_FIELD_TASK_ASSIGNED_TO [taillabel="1", labeldistance=2];
  e_FIELD_TASK -- r_FK_FIELD_TASK_ASSIGNED_TO [taillabel="N", labeldistance=2, color="black:white:black"];
  e_PREMISE -- r_FK_FIELD_TASK_TASK_AT [taillabel="1", labeldistance=2];
  e_FIELD_TASK -- r_FK_FIELD_TASK_TASK_AT [taillabel="N", labeldistance=2];
  e_METER -- r_FK_FIELD_TASK_TASK_ON [taillabel="1", labeldistance=2];
  e_FIELD_TASK -- r_FK_FIELD_TASK_TASK_ON [taillabel="N", labeldistance=2];
  e_SERVICE_REQUEST -- r_FK_FIELD_TASK_RESOLVED_BY [taillabel="1", labeldistance=2];
  e_FIELD_TASK -- r_FK_FIELD_TASK_RESOLVED_BY [taillabel="N", labeldistance=2];
  e_FIELD_TASK -- r_FK_ATTACHMENT_EVIDENCE [taillabel="1", labeldistance=2];
  e_ATTACHMENT -- r_FK_ATTACHMENT_EVIDENCE [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_AVAILABILITY_DECLARES [taillabel="1", labeldistance=2];
  e_AVAILABILITY -- r_FK_AVAILABILITY_DECLARES [taillabel="N", labeldistance=2, color="black:white:black"];
  e_FIELD_TASK -- r_FK_TASK_NOTE_HAS_NOTE [taillabel="1", labeldistance=2];
  e_TASK_NOTE -- r_FK_TASK_NOTE_HAS_NOTE [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_TASK_NOTE_WROTE [taillabel="1", labeldistance=2];
  e_TASK_NOTE -- r_FK_TASK_NOTE_WROTE [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_IN_CATEGORY [taillabel="M", labeldistance=2];
  e_TECHNICIAN_CATEGORY -- r_IN_CATEGORY [taillabel="N", labeldistance=2];
  e_AVAILABILITY -- r_AVAILABLE_IN [taillabel="M", labeldistance=2];
  e_MUNICIPALITY -- r_AVAILABLE_IN [taillabel="N", labeldistance=2];
  e_FIELD_TASK -- r_NOTIFIES [taillabel="M", labeldistance=2];
  e_USER_ACCOUNT -- r_NOTIFIES [taillabel="N", labeldistance=2];
  e_METER -- r_FK_EVENT_EVENT_ON [taillabel="1", labeldistance=2];
  e_EVENT -- r_FK_EVENT_EVENT_ON [taillabel="N", labeldistance=2];
  e_TELEMETRY_PACKET -- r_FK_EVENT_EVENT_FROM [taillabel="1", labeldistance=2];
  e_EVENT -- r_FK_EVENT_EVENT_FROM [taillabel="N", labeldistance=2];
  e_FIELD_TASK -- r_FK_EVENT_FOUND_DURING [taillabel="1", labeldistance=2];
  e_EVENT -- r_FK_EVENT_FOUND_DURING [taillabel="N", labeldistance=2];
  e_EVENT -- r_LEADS_TO [taillabel="M", labeldistance=2];
  e_FIELD_TASK -- r_LEADS_TO [taillabel="N", labeldistance=2];
  e_METER -- r_FK_METER_INSTALLATION_INSTALLED [taillabel="1", labeldistance=2];
  e_METER_INSTALLATION -- r_FK_METER_INSTALLATION_INSTALLED [taillabel="N", labeldistance=2, color="black:white:black"];
  e_PREMISE -- r_FK_METER_INSTALLATION_INSTALLED_AT [taillabel="1", labeldistance=2];
  e_METER_INSTALLATION -- r_FK_METER_INSTALLATION_INSTALLED_AT [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_METER_INSTALLATION_CONFIRMS [taillabel="1", labeldistance=2];
  e_METER_INSTALLATION -- r_FK_METER_INSTALLATION_CONFIRMS [taillabel="N", labeldistance=2];
  e_FIELD_TASK -- r_FK_METER_INSTALLATION_DONE_IN [taillabel="1", labeldistance=2];
  e_METER_INSTALLATION -- r_FK_METER_INSTALLATION_DONE_IN [taillabel="1", labeldistance=2, color="black:white:black"];
}
