graph ER {
  layout=neato;
  overlap=prism; overlap_scaling=-6; sep="+14"; splines=true;
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
  labelloc=t; fontsize=20; fontname="Helvetica-Bold"; label="ER diagram (Chen): Grid and control";
  e_USER_ACCOUNT [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="USER_ACCOUNT"];
  e_GEOFENCE [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="GEOFENCE"];
  a_GEOFENCE_GeofenceID [shape=ellipse, style="filled", fillcolor=white, label=<<U>GeofenceID</U>>];
  a_GEOFENCE_Name [shape=ellipse, style=filled, fillcolor=white, label="Name"];
  a_GEOFENCE_MinLat [shape=ellipse, style=filled, fillcolor=white, label="MinLat"];
  a_GEOFENCE_MinLon [shape=ellipse, style=filled, fillcolor=white, label="MinLon"];
  a_GEOFENCE_MaxLat [shape=ellipse, style=filled, fillcolor=white, label="MaxLat"];
  e_TRANSFORMER [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="TRANSFORMER"];
  a_TRANSFORMER_TransformerID [shape=ellipse, style="filled", fillcolor=white, label=<<U>TransformerID</U>>];
  a_TRANSFORMER_Name [shape=ellipse, style=filled, fillcolor=white, label="Name"];
  a_TRANSFORMER_Latitude [shape=ellipse, style=filled, fillcolor=white, label="Latitude"];
  a_TRANSFORMER_Longitude [shape=ellipse, style=filled, fillcolor=white, label="Longitude"];
  e_METER [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="METER"];
  e_LOAD_SHED_ORDER [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="LOAD_SHED_ORDER"];
  a_LOAD_SHED_ORDER_ShedOrderID [shape=ellipse, style="filled", fillcolor=white, label=<<U>ShedOrderID</U>>];
  a_LOAD_SHED_ORDER_Reason [shape=ellipse, style=filled, fillcolor=white, label="Reason"];
  a_LOAD_SHED_ORDER_Status [shape=ellipse, style=filled, fillcolor=white, label="Status"];
  e_REMOTE_COMMAND [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="REMOTE_COMMAND"];
  a_REMOTE_COMMAND_CommandID [shape=ellipse, style="filled", fillcolor=white, label=<<U>CommandID</U>>];
  a_REMOTE_COMMAND_CommandType [shape=ellipse, style=filled, fillcolor=white, label="CommandType"];
  a_REMOTE_COMMAND_Parameters [shape=ellipse, style=filled, fillcolor=white, label="Parameters"];
  a_REMOTE_COMMAND_RequestedAt [shape=ellipse, style=filled, fillcolor=white, label="RequestedAt"];
  a_REMOTE_COMMAND_Status [shape=ellipse, style=filled, fillcolor=white, label="Status"];
  e_COMMAND_ATTEMPT [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="COMMAND_ATTEMPT", peripheries=2];
  a_COMMAND_ATTEMPT_AttemptNo [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>AttemptNo</U>>];
  a_COMMAND_ATTEMPT_AttemptAt [shape=ellipse, style=filled, fillcolor=white, label="AttemptAt"];
  a_COMMAND_ATTEMPT_RespondedAt [shape=ellipse, style=filled, fillcolor=white, label="RespondedAt"];
  a_COMMAND_ATTEMPT_Outcome [shape=ellipse, style=filled, fillcolor=white, label="Outcome"];
  e_OBIS_CODE [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="OBIS_CODE"];
  e_TRANSFORMER_AGGREGATE [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="TRANSFORMER_AGGREGATE", peripheries=2];
  a_TRANSFORMER_AGGREGATE_PeriodType [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>PeriodType</U>>];
  a_TRANSFORMER_AGGREGATE_PeriodStart [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>PeriodStart</U>>];
  a_TRANSFORMER_AGGREGATE_SumValue [shape=ellipse, style=filled, fillcolor=white, label="SumValue"];
  a_TRANSFORMER_AGGREGATE_MeterCount [shape=ellipse, style=filled, fillcolor=white, label="MeterCount"];
  a_TRANSFORMER_AGGREGATE_ComputedAt [shape=ellipse, style=filled, fillcolor=white, label="ComputedAt"];
  r_FK_TRANSFORMER_SERVICE_AREA [shape=diamond, style=filled, fillcolor="#fbeeb8", label="SERVICE AREA", height=0.7, width=1.3];
  r_FK_TRANSFORMER_PARENT_OF [shape=diamond, style=filled, fillcolor="#fbeeb8", label="PARENT OF", height=0.7, width=1.3];
  r_FK_METER_SERVED_BY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="SERVED BY", height=0.7, width=1.3];
  r_FK_LOAD_SHED_ORDER_SHEDS [shape=diamond, style=filled, fillcolor="#fbeeb8", label="SHEDS", height=0.7, width=1.3];
  r_FK_LOAD_SHED_ORDER_ORDERED_BY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="ORDERED BY", height=0.7, width=1.3];
  r_FK_REMOTE_COMMAND_TARGETS [shape=diamond, style=filled, fillcolor="#fbeeb8", label="TARGETS", height=0.7, width=1.3];
  r_FK_REMOTE_COMMAND_REQUESTED_BY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="REQUESTED BY", height=0.7, width=1.3];
  r_FK_REMOTE_COMMAND_APPROVED_BY [shape=diamond, style=filled, fillcolor="#fbeeb8", label="APPROVED BY", height=0.7, width=1.3];
  r_FK_REMOTE_COMMAND_SHED_COMMAND [shape=diamond, style=filled, fillcolor="#fbeeb8", label="SHED COMMAND", height=0.7, width=1.3];
  r_FK_COMMAND_ATTEMPT_TRIES [shape=diamond, style=filled, fillcolor="#fbeeb8", peripheries=2, label="TRIES", height=0.7, width=1.3];
  r_FK_TRANSFORMER_AGGREGATE_TR_AGG [shape=diamond, style=filled, fillcolor="#fbeeb8", peripheries=2, label="TR AGG", height=0.7, width=1.3];
  r_FK_TRANSFORMER_AGGREGATE_TR_AGG_CODE [shape=diamond, style=filled, fillcolor="#fbeeb8", peripheries=2, label="AGG CODE", height=0.7, width=1.3];
  r_TRANSFORMER_CURRENT_STATE [shape=diamond, style=filled, fillcolor="#fbeeb8", label="TRANSFORMER CURRENT STATE", height=0.7, width=1.3];
  a_TRANSFORMER_CURRENT_STATE_RefInterval [shape=ellipse, style=filled, fillcolor=white, label="RefInterval"];
  a_TRANSFORMER_CURRENT_STATE_SumValue [shape=ellipse, style=filled, fillcolor=white, label="SumValue"];
  a_TRANSFORMER_CURRENT_STATE_MeterCount [shape=ellipse, style=filled, fillcolor=white, label="MeterCount"];
  a_TRANSFORMER_CURRENT_STATE_ComputedAt [shape=ellipse, style=filled, fillcolor=white, label="ComputedAt"];
  e_GEOFENCE -- a_GEOFENCE_GeofenceID;
  e_GEOFENCE -- a_GEOFENCE_Name;
  e_GEOFENCE -- a_GEOFENCE_MinLat;
  e_GEOFENCE -- a_GEOFENCE_MinLon;
  e_GEOFENCE -- a_GEOFENCE_MaxLat;
  e_TRANSFORMER -- a_TRANSFORMER_TransformerID;
  e_TRANSFORMER -- a_TRANSFORMER_Name;
  e_TRANSFORMER -- a_TRANSFORMER_Latitude;
  e_TRANSFORMER -- a_TRANSFORMER_Longitude;
  e_LOAD_SHED_ORDER -- a_LOAD_SHED_ORDER_ShedOrderID;
  e_LOAD_SHED_ORDER -- a_LOAD_SHED_ORDER_Reason;
  e_LOAD_SHED_ORDER -- a_LOAD_SHED_ORDER_Status;
  e_REMOTE_COMMAND -- a_REMOTE_COMMAND_CommandID;
  e_REMOTE_COMMAND -- a_REMOTE_COMMAND_CommandType;
  e_REMOTE_COMMAND -- a_REMOTE_COMMAND_Parameters;
  e_REMOTE_COMMAND -- a_REMOTE_COMMAND_RequestedAt;
  e_REMOTE_COMMAND -- a_REMOTE_COMMAND_Status;
  e_COMMAND_ATTEMPT -- a_COMMAND_ATTEMPT_AttemptNo;
  e_COMMAND_ATTEMPT -- a_COMMAND_ATTEMPT_AttemptAt;
  e_COMMAND_ATTEMPT -- a_COMMAND_ATTEMPT_RespondedAt;
  e_COMMAND_ATTEMPT -- a_COMMAND_ATTEMPT_Outcome;
  e_TRANSFORMER_AGGREGATE -- a_TRANSFORMER_AGGREGATE_PeriodType;
  e_TRANSFORMER_AGGREGATE -- a_TRANSFORMER_AGGREGATE_PeriodStart;
  e_TRANSFORMER_AGGREGATE -- a_TRANSFORMER_AGGREGATE_SumValue;
  e_TRANSFORMER_AGGREGATE -- a_TRANSFORMER_AGGREGATE_MeterCount;
  e_TRANSFORMER_AGGREGATE -- a_TRANSFORMER_AGGREGATE_ComputedAt;
  e_GEOFENCE -- r_FK_TRANSFORMER_SERVICE_AREA [taillabel="1", labeldistance=2];
  e_TRANSFORMER -- r_FK_TRANSFORMER_SERVICE_AREA [taillabel="1", labeldistance=2, color="black:white:black"];
  e_TRANSFORMER -- r_FK_TRANSFORMER_PARENT_OF [taillabel="1 (parent)", labeldistance=2.2];
  e_TRANSFORMER -- r_FK_TRANSFORMER_PARENT_OF [taillabel="N (child)", labeldistance=2.2];
  e_TRANSFORMER -- r_FK_METER_SERVED_BY [taillabel="1", labeldistance=2];
  e_METER -- r_FK_METER_SERVED_BY [taillabel="N", labeldistance=2, color="black:white:black"];
  e_TRANSFORMER -- r_FK_LOAD_SHED_ORDER_SHEDS [taillabel="1", labeldistance=2];
  e_LOAD_SHED_ORDER -- r_FK_LOAD_SHED_ORDER_SHEDS [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_LOAD_SHED_ORDER_ORDERED_BY [taillabel="1", labeldistance=2];
  e_LOAD_SHED_ORDER -- r_FK_LOAD_SHED_ORDER_ORDERED_BY [taillabel="N", labeldistance=2, color="black:white:black"];
  e_METER -- r_FK_REMOTE_COMMAND_TARGETS [taillabel="1", labeldistance=2];
  e_REMOTE_COMMAND -- r_FK_REMOTE_COMMAND_TARGETS [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_REMOTE_COMMAND_REQUESTED_BY [taillabel="1", labeldistance=2];
  e_REMOTE_COMMAND -- r_FK_REMOTE_COMMAND_REQUESTED_BY [taillabel="N", labeldistance=2, color="black:white:black"];
  e_USER_ACCOUNT -- r_FK_REMOTE_COMMAND_APPROVED_BY [taillabel="1", labeldistance=2];
  e_REMOTE_COMMAND -- r_FK_REMOTE_COMMAND_APPROVED_BY [taillabel="N", labeldistance=2];
  e_LOAD_SHED_ORDER -- r_FK_REMOTE_COMMAND_SHED_COMMAND [taillabel="1", labeldistance=2];
  e_REMOTE_COMMAND -- r_FK_REMOTE_COMMAND_SHED_COMMAND [taillabel="N", labeldistance=2];
  e_REMOTE_COMMAND -- r_FK_COMMAND_ATTEMPT_TRIES [taillabel="1", labeldistance=2];
  e_COMMAND_ATTEMPT -- r_FK_COMMAND_ATTEMPT_TRIES [taillabel="N", labeldistance=2, color="black:white:black"];
  e_TRANSFORMER -- r_FK_TRANSFORMER_AGGREGATE_TR_AGG [taillabel="1", labeldistance=2];
  e_TRANSFORMER_AGGREGATE -- r_FK_TRANSFORMER_AGGREGATE_TR_AGG [taillabel="N", labeldistance=2, color="black:white:black"];
  e_OBIS_CODE -- r_FK_TRANSFORMER_AGGREGATE_TR_AGG_CODE [taillabel="1", labeldistance=2];
  e_TRANSFORMER_AGGREGATE -- r_FK_TRANSFORMER_AGGREGATE_TR_AGG_CODE [taillabel="N", labeldistance=2, color="black:white:black"];
  e_TRANSFORMER -- r_TRANSFORMER_CURRENT_STATE [taillabel="M", labeldistance=2];
  e_OBIS_CODE -- r_TRANSFORMER_CURRENT_STATE [taillabel="N", labeldistance=2];
  r_TRANSFORMER_CURRENT_STATE -- a_TRANSFORMER_CURRENT_STATE_RefInterval;
  r_TRANSFORMER_CURRENT_STATE -- a_TRANSFORMER_CURRENT_STATE_SumValue;
  r_TRANSFORMER_CURRENT_STATE -- a_TRANSFORMER_CURRENT_STATE_MeterCount;
  r_TRANSFORMER_CURRENT_STATE -- a_TRANSFORMER_CURRENT_STATE_ComputedAt;
}
