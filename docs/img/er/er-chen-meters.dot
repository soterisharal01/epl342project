graph ER {
  layout=neato;
  overlap=prism; overlap_scaling=-6; sep="+14"; splines=true;
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
  labelloc=t; fontsize=20; fontname="Helvetica-Bold"; label="ER diagram (Chen): Meters and readings";
  e_USER_ACCOUNT [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="USER_ACCOUNT"];
  e_METER_MODEL [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="METER_MODEL"];
  a_METER_MODEL_ModelID [shape=ellipse, style="filled", fillcolor=white, label=<<U>ModelID</U>>];
  a_METER_MODEL_Manufacturer [shape=ellipse, style=filled, fillcolor=white, label="Manufacturer"];
  a_METER_MODEL_ModelName [shape=ellipse, style=filled, fillcolor=white, label="ModelName"];
  a_METER_MODEL_MeterType [shape=ellipse, style=filled, fillcolor=white, label="MeterType"];
  a_METER_MODEL_PhaseCount [shape=ellipse, style=filled, fillcolor=white, label="PhaseCount"];
  e_COMM_TYPE [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="COMM_TYPE"];
  a_COMM_TYPE_CommTypeID [shape=ellipse, style="filled", fillcolor=white, label=<<U>CommTypeID</U>>];
  a_COMM_TYPE_Name [shape=ellipse, style=filled, fillcolor=white, label="Name"];
  e_TRANSFORMER [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="TRANSFORMER"];
  e_METER [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="METER"];
  a_METER_MeterID [shape=ellipse, style="filled", fillcolor=white, label=<<U>MeterID</U>>];
  a_METER_SerialNumber [shape=ellipse, style=filled, fillcolor=white, label="SerialNumber"];
  a_METER_NetworkID [shape=ellipse, style=filled, fillcolor=white, label="NetworkID"];
  a_METER_Firmware [shape=ellipse, style=filled, fillcolor=white, label="Firmware"];
  a_METER_MaxLoadAmps [shape=ellipse, style=filled, fillcolor=white, label="MaxLoadAmps"];
  a_METER_ConnectedPhase [shape=ellipse, peripheries=2, style=filled, fillcolor=white, label="ConnectedPhase"];
  e_SERVICE_REQUEST [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="SERVICE_REQUEST"];
  e_DOCUMENT [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="DOCUMENT"];
  e_FIELD_TASK [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="FIELD_TASK"];
  e_TELEMETRY_PACKET [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="TELEMETRY_PACKET"];
  a_TELEMETRY_PACKET_PacketID [shape=ellipse, style="filled", fillcolor=white, label=<<U>PacketID</U>>];
  a_TELEMETRY_PACKET_ReceivedNetworkID [shape=ellipse, style=filled, fillcolor=white, label="ReceivedNetworkID"];
  a_TELEMETRY_PACKET_TransmissionTimestamp [shape=ellipse, style=filled, fillcolor=white, label="TransmissionTimestamp"];
  a_TELEMETRY_PACKET_ReceivedAt [shape=ellipse, style=filled, fillcolor=white, label="ReceivedAt"];
  a_TELEMETRY_PACKET_NetworkType [shape=ellipse, style=filled, fillcolor=white, label="NetworkType"];
  e_EVENT [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="EVENT"];
  e_METER_INSTALLATION [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="METER_INSTALLATION"];
  e_REMOTE_COMMAND [shape=box, style="dashed,filled", fillcolor="#f4f4f4", label="REMOTE_COMMAND"];
