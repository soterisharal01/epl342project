  a_VEE_RUN_RunID [shape=ellipse, style="filled", fillcolor=white, label=<<U>RunID</U>>];
  a_VEE_RUN_PeriodFrom [shape=ellipse, style=filled, fillcolor=white, label="PeriodFrom"];
  a_VEE_RUN_PeriodTo [shape=ellipse, style=filled, fillcolor=white, label="PeriodTo"];
  a_VEE_RUN_StartedAt [shape=ellipse, style=filled, fillcolor=white, label="StartedAt"];
  a_VEE_RUN_FinishedAt [shape=ellipse, style=filled, fillcolor=white, label="FinishedAt"];
  e_RAW_READING [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="RAW_READING", peripheries=2];
  a_RAW_READING_IntervalStart [shape=ellipse, style="dashed,filled", fillcolor=white, label=<<U>IntervalStart</U>>];
