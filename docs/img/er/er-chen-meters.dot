  a_OBIS_CODE_Description [shape=ellipse, style=filled, fillcolor=white, label="Description"];
  a_OBIS_CODE_Unit [shape=ellipse, style=filled, fillcolor=white, label="Unit"];
  a_OBIS_CODE_Kind [shape=ellipse, style=filled, fillcolor=white, label="Kind"];
  a_OBIS_CODE_Phase [shape=ellipse, style=filled, fillcolor=white, label="Phase"];
  e_VEE_RULE [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="VEE_RULE"];
