graph ER {
  layout=neato;
  overlap=prism; overlap_scaling=-6; sep="+14"; splines=true;
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
  labelloc=t; fontsize=20; fontname="Helvetica-Bold"; label="MDMS-Cy ER diagram (Chen), overview with key attributes";
  e_SUPPLIER [shape=box, style=filled, fillcolor="#dfe9f5", margin="0.18,0.10", penwidth=1.4, label="SUPPLIER"];
  a_SUPPLIER_SupplierID [shape=ellipse, style="filled", fillcolor=white, label=<<U>SupplierID</U>>];
