  t_FIELD_TASK:c_MeterID -> t_METER [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_FIELD_TASK_TASK_ON"];
  t_FIELD_TASK:c_RequestID -> t_SERVICE_REQUEST [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_FIELD_TASK_RESOLVED_BY"];
  t_ATTACHMENT:c_TaskID -> t_FIELD_TASK:c_TaskID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_ATTACHMENT_EVIDENCE"];
  t_AVAILABILITY:c_UserID -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_AVAILABILITY_DECLARES"];
  t_TASK_NOTE:c_TaskID -> t_FIELD_TASK:c_TaskID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TASK_NOTE_HAS_NOTE"];
  t_TASK_NOTE:c_WrittenBy -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TASK_NOTE_WROTE"];
  t_IN_CATEGORY:c_UserID -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_IN_CATEGORY_FIELD_TECHNICIAN"];
  t_IN_CATEGORY:c_CategoryID -> t_TECHNICIAN_CATEGORY:c_CategoryID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_IN_CATEGORY_TECHNICIAN_CATEGORY"];
  t_AVAILABLE_IN:c_UserID -> t_AVAILABILITY:c_UserID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_AVAILABLE_IN_AVAILABILITY"];
  t_AVAILABLE_IN:c_MunicipalityID -> t_MUNICIPALITY [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_AVAILABLE_IN_MUNICIPALITY"];
