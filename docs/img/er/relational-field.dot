digraph REL {
  rankdir=LR; nodesep=0.25; ranksep=1.1; compound=true;
  node [shape=plain, fontname="Helvetica", fontsize=10]; edge [color="#555555", arrowsize=0.7];
  labelloc=t; fontsize=22; fontname="Helvetica-Bold"; label="Relational diagram: Field work and events";
  subgraph cluster_users { label="Users, premises and billing"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_USER_ACCOUNT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>USER_ACCOUNT</B></TD></TR></TABLE>>];
    t_MUNICIPALITY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>MUNICIPALITY</B></TD></TR></TABLE>>];
    t_PREMISE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>PREMISE</B></TD></TR></TABLE>>];
    t_SERVICE_REQUEST [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>SERVICE_REQUEST</B></TD></TR></TABLE>>];
  }
  subgraph cluster_meters { label="Meters and readings"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_METER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER</B></TD></TR></TABLE>>];
    t_TELEMETRY_PACKET [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>TELEMETRY_PACKET</B></TD></TR></TABLE>>];
  }
  subgraph cluster_field { label="Field work and events"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_TECHNICIAN_CATEGORY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>TECHNICIAN_CATEGORY</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_CategoryID"><B>CategoryID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR></TABLE>>];
    t_DOCUMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>DOCUMENT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_DocumentID"><B>DocumentID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_DocType">DocType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(27)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_DocNumber">DocNumber</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_IssueDate">IssueDate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ExpiryDate"><I>ExpiryDate</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_FilePath">FilePath</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(400)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReviewStatus">ReviewStatus</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(8)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReviewComment"><I>ReviewComment</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReviewedAt"><I>ReviewedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TechnicianID"><I>TechnicianID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><I>MeterID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ReviewedBy"><I>ReviewedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_FIELD_TASK [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>FIELD_TASK</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID"><B>TaskID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskType">TaskType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(17)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ScheduledFrom">ScheduledFrom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ScheduledTo">ScheduledTo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Status">Status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Result"><I>Result</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_CreatedAt">CreatedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_CompletedAt"><I>CompletedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TechnicianID">TechnicianID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_PremiseID"><I>PremiseID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><I>MeterID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_RequestID"><I>RequestID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_ATTACHMENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>ATTACHMENT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_AttachmentID"><B>AttachmentID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_FilePath">FilePath</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(400)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Caption"><I>Caption</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_UploadedAt">UploadedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID">TaskID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_AVAILABILITY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>AVAILABILITY</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_UserID"><B>UserID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_AvailDate"><B>AvailDate</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_FromTime"><B>FromTime</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIME(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ToTime">ToTime</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIME(0)</FONT></TD></TR></TABLE>>];
    t_TASK_NOTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>TASK_NOTE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID"><B>TaskID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_NoteNo"><B>NoteNo</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_NoteKind">NoteKind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Text">Text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(2000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_WrittenAt">WrittenAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_WrittenBy">WrittenBy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_IN_CATEGORY [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>IN_CATEGORY</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_UserID"><B>UserID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_CategoryID"><B>CategoryID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_AVAILABLE_IN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>AVAILABLE_IN</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_UserID"><B>UserID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_AvailDate"><B>AvailDate</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_FromTime"><B>FromTime</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIME(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MunicipalityID"><B>MunicipalityID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_NOTIFIES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>NOTIFIES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID"><B>TaskID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_UserID"><B>UserID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_EVENT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>EVENT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_EventID"><B>EventID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_EventType">EventType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Severity">Severity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(8)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Description"><I>Description</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_OccurredAt">OccurredAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Status">Status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(11)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><I>MeterID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_PacketID"><I>PacketID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID"><I>TaskID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_LEADS_TO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>LEADS_TO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_EventID"><B>EventID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID"><B>TaskID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_METER_INSTALLATION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fdf0d8"><B>METER_INSTALLATION</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_InstallationID"><B>InstallationID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_InstalledAt">InstalledAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RemovedAt"><I>RemovedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ConfirmationStatus">ConfirmationStatus</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ConfirmedAt"><I>ConfirmedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ConfirmComment"><I>ConfirmComment</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID">MeterID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_PremiseID">PremiseID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ConfirmedBy"><I>ConfirmedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_TaskID">TaskID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
  }
  t_DOCUMENT:c_TechnicianID -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_DOCUMENT_TECH_DOC"];
  t_DOCUMENT:c_MeterID -> t_METER [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_DOCUMENT_METER_DOC"];
  t_DOCUMENT:c_ReviewedBy -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_DOCUMENT_REVIEWS"];
