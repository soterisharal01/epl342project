digraph REL {
  rankdir=LR; nodesep=0.25; ranksep=1.1; compound=true;
  node [shape=plain, fontname="Helvetica", fontsize=10]; edge [color="#555555", arrowsize=0.7];
  labelloc=t; fontsize=22; fontname="Helvetica-Bold"; label="Relational diagram: Grid and control";
  subgraph cluster_users { label="Users, premises and billing"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_USER_ACCOUNT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>USER_ACCOUNT</B></TD></TR></TABLE>>];
  }
  subgraph cluster_meters { label="Meters and readings"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_METER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER</B></TD></TR></TABLE>>];
    t_OBIS_CODE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>OBIS_CODE</B></TD></TR></TABLE>>];
  }
  subgraph cluster_grid { label="Grid and control"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_GEOFENCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>GEOFENCE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_GeofenceID"><B>GeofenceID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MinLat">MinLat</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MinLon">MinLon</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MaxLat">MaxLat</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MaxLon">MaxLon</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR></TABLE>>];
    t_TRANSFORMER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>TRANSFORMER</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_TransformerID"><B>TransformerID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Latitude">Latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Longitude">Longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_GeofenceID">GeofenceID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ParentTransformerID"><I>ParentTransformerID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_LOAD_SHED_ORDER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>LOAD_SHED_ORDER</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_ShedOrderID"><B>ShedOrderID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Reason">Reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_CreatedAt">CreatedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Status">Status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TransformerID">TransformerID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_OrderedBy">OrderedBy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_REMOTE_COMMAND [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>REMOTE_COMMAND</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_CommandID"><B>CommandID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_CommandType">CommandType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Parameters"><I>Parameters</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RequestedAt">RequestedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Status">Status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(17)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID">MeterID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_RequestedBy">RequestedBy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ApprovedBy"><I>ApprovedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ShedOrderID"><I>ShedOrderID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_COMMAND_ATTEMPT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>COMMAND_ATTEMPT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_CommandID"><B>CommandID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_AttemptNo"><B>AttemptNo</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_AttemptAt">AttemptAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RespondedAt"><I>RespondedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Outcome"><I>Outcome</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(7)</FONT></TD></TR></TABLE>>];
    t_TRANSFORMER_AGGREGATE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>TRANSFORMER_AGGREGATE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TransformerID"><B>TransformerID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodType"><B>PeriodType</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodStart"><B>PeriodStart</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_SumValue">SumValue</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(18,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterCount">MeterCount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ComputedAt">ComputedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR></TABLE>>];
    t_TRANSFORMER_CURRENT_STATE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#f3e5f5"><B>TRANSFORMER_CURRENT_STATE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TransformerID"><B>TransformerID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RefInterval">RefInterval</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_SumValue">SumValue</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(18,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterCount">MeterCount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ComputedAt">ComputedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR></TABLE>>];
  }
  t_TRANSFORMER:c_GeofenceID -> t_GEOFENCE:c_GeofenceID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_SERVICE_AREA"];
  t_TRANSFORMER:c_ParentTransformerID -> t_TRANSFORMER:c_TransformerID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_PARENT_OF"];
  t_METER -> t_TRANSFORMER:c_TransformerID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_METER_SERVED_BY"];
  t_LOAD_SHED_ORDER:c_TransformerID -> t_TRANSFORMER:c_TransformerID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_LOAD_SHED_ORDER_SHEDS"];
  t_LOAD_SHED_ORDER:c_OrderedBy -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_LOAD_SHED_ORDER_ORDERED_BY"];
  t_REMOTE_COMMAND:c_MeterID -> t_METER [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_REMOTE_COMMAND_TARGETS"];
  t_REMOTE_COMMAND:c_RequestedBy -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_REMOTE_COMMAND_REQUESTED_BY"];
  t_REMOTE_COMMAND:c_ApprovedBy -> t_USER_ACCOUNT [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_REMOTE_COMMAND_APPROVED_BY"];
  t_REMOTE_COMMAND:c_ShedOrderID -> t_LOAD_SHED_ORDER:c_ShedOrderID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_REMOTE_COMMAND_SHED_COMMAND"];
  t_COMMAND_ATTEMPT:c_CommandID -> t_REMOTE_COMMAND:c_CommandID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_COMMAND_ATTEMPT_TRIES"];
  t_TRANSFORMER_AGGREGATE:c_TransformerID -> t_TRANSFORMER:c_TransformerID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_AGGREGATE_TR_AGG"];
  t_TRANSFORMER_AGGREGATE:c_ObisCode -> t_OBIS_CODE [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_AGGREGATE_TR_AGG_CODE"];
  t_TRANSFORMER_CURRENT_STATE:c_TransformerID -> t_TRANSFORMER:c_TransformerID [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_CURRENT_STATE_TR_STATE"];
  t_TRANSFORMER_CURRENT_STATE:c_ObisCode -> t_OBIS_CODE [dir=both, arrowtail=crow, arrowhead=tee, tooltip="FK_TRANSFORMER_CURRENT_STATE_STATE_CODE"];
}
