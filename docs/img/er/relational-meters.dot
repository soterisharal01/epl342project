digraph REL {
  rankdir=LR; nodesep=0.25; ranksep=1.1; compound=true;
  node [shape=plain, fontname="Helvetica", fontsize=10]; edge [color="#555555", arrowsize=0.7];
  labelloc=t; fontsize=22; fontname="Helvetica-Bold"; label="Relational diagram: Meters and readings";
  subgraph cluster_users { label="Users, premises and billing"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_USER_ACCOUNT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>USER_ACCOUNT</B></TD></TR></TABLE>>];
    t_SERVICE_REQUEST [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>SERVICE_REQUEST</B></TD></TR></TABLE>>];
  }
  subgraph cluster_meters { label="Meters and readings"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_METER_MODEL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER_MODEL</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_ModelID"><B>ModelID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Manufacturer">Manufacturer</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_ModelName">ModelName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterType">MeterType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_PhaseCount">PhaseCount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT</FONT></TD></TR></TABLE>>];
    t_COMM_TYPE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>COMM_TYPE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_CommTypeID"><B>CommTypeID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(30)</FONT></TD></TR></TABLE>>];
    t_METER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_SerialNumber">SerialNumber</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_NetworkID">NetworkID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Firmware">Firmware</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MaxLoadAmps">MaxLoadAmps</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(6,1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Latitude">Latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Longitude">Longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Status">Status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ModelID">ModelID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_CommTypeID">CommTypeID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_TransformerID">TransformerID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_TELEMETRY_PACKET [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>TELEMETRY_PACKET</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_PacketID"><B>PacketID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReceivedNetworkID"><I>ReceivedNetworkID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_TransmissionTimestamp"><I>TransmissionTimestamp</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReceivedAt">ReceivedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_NetworkType"><I>NetworkType</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_SignalDbm"><I>SignalDbm</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RawPayload">RawPayload</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_IngestStatus">IngestStatus</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(18)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ErrorMessage"><I>ErrorMessage</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><I>MeterID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_METER_CONNECTED_PHASE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER_CONNECTED_PHASE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_ConnectedPhase"><B>ConnectedPhase</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">CHAR(2)</FONT></TD></TR></TABLE>>];
    t_OBIS_CODE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>OBIS_CODE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Description">Description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Unit">Unit</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Kind">Kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(19)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Phase"><I>Phase</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">CHAR(2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MinValid"><I>MinValid</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_MaxValid"><I>MaxValid</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR></TABLE>>];
    t_VEE_RULE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>VEE_RULE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_RuleID"><B>RuleID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RuleType">RuleType</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Parameters"><I>Parameters</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_IsActive">IsActive</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIT</FONT></TD></TR></TABLE>>];
    t_VEE_RUN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>VEE_RUN</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_RunID"><B>RunID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodFrom">PeriodFrom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodTo">PeriodTo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_StartedAt">StartedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_FinishedAt"><I>FinishedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR></TABLE>>];
    t_RAW_READING [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>RAW_READING</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_IntervalStart"><B>IntervalStart</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReceivedValue">ReceivedValue</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_VeeStatus">VeeStatus</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_PacketID">PacketID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT</FONT></TD></TR></TABLE>>];
    t_VALIDATED_READING [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>VALIDATED_READING</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_IntervalStart"><B>IntervalStart</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Value">Value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Quality">Quality</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_RunID">RunID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ValidatedAt">ValidatedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR></TABLE>>];
    t_READING_EDIT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>READING_EDIT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_IntervalStart"><B>IntervalStart</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_EditNo"><B>EditNo</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_OldValue"><I>OldValue</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_NewValue">NewValue</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Origin">Origin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(18)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_EditedAt">EditedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Reason"><I>Reason</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_EditedBy"><I>EditedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_RuleID"><I>RuleID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
    t_RULE_FOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>RULE_FOR</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_RuleID"><B>RuleID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR></TABLE>>];
    t_METER_AGGREGATE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e6f4e1"><B>METER_AGGREGATE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_MeterID"><B>MeterID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ObisCode"><B>ObisCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodType"><B>PeriodType</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_PeriodStart"><B>PeriodStart</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_SumValue">SumValue</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DECIMAL(18,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ReadingCount">ReadingCount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_EstimatedCount">EstimatedCount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
  }
