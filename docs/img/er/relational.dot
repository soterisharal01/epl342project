    t_PARISH [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>PARISH</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_ParishID"><B>ParishID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_MunicipalityID">MunicipalityID</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
