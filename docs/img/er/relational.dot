digraph REL {
  rankdir=LR; nodesep=0.25; ranksep=1.1; compound=true;
  node [shape=plain, fontname="Helvetica", fontsize=10]; edge [color="#555555", arrowsize=0.7];
  labelloc=t; fontsize=22; fontname="Helvetica-Bold"; label="MDMS-Cy relational diagram (all 56 tables)";
  subgraph cluster_users { label="Users, premises and billing"; style="rounded,dashed"; color="#999999"; fontname="Helvetica-Bold"; fontsize=16;
    t_SUPPLIER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>SUPPLIER</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_SupplierID"><B>SupplierID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR></TABLE>>];
    t_AGGREGATOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>AGGREGATOR</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_AggregatorID"><B>AggregatorID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Name">Name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(100)</FONT></TD></TR></TABLE>>];
    t_USER_ACCOUNT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e3eefb"><B>USER_ACCOUNT</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" PORT="c_UserID"><B>UserID</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT" PORT="c_Username">Username</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_PasswordHash">PasswordHash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Role">Role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Email">Email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(254)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Phone"><I>Phone</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_FirstName">FirstName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_LastName">LastName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_AccountStatus">AccountStatus</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_CreatedAt">CreatedAt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_CreatedBy"><I>CreatedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_RawRetentionMonths"><I>RawRetentionMonths</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_BirthDate"><I>BirthDate</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_Photo"><I>Photo</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">NVARCHAR(400)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ApprovalStatus"><I>ApprovalStatus</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="c_ApprovalDecidedAt"><I>ApprovalDecidedAt</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATETIME2(0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_ApprovedBy"><I>ApprovedBy</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_SupplierID"><I>SupplierID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" PORT="c_AggregatorID"><I>AggregatorID</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
